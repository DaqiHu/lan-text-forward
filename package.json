{
  "name": "lan-paste",
  "version": "1.0.0",
  "description": "局域网快传粘贴服务 - 手机打字，电脑粘贴",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "tsc",
    "build:client": "npm run build --prefix client",
    "start": "node dist/server.js",
    "test": "npm run test:run --prefix client",
    "test:watch": "npm run test --prefix client"
  },
  "dependencies": {
    "clipboardy": "^3.0.0",
    "express": "^4.21.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
